{
  "name": "@contextweave/desktop",
  "private": true,
  "version": "0.1.2",
  "description": "ContextWeave personal browser workspace desktop client.",
  "author": "mik-myp",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --config electron-builder.json5",
    "build:dir": "electron-vite build && electron-builder --config electron-builder.json5 --dir",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --config .prettierrc.json --write .",
    "format:check": "prettier --config .prettierrc.json --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@contextweave/contracts": "workspace:*",
    "@contextweave/kernel-core": "workspace:*",
    "@contextweave/kernel-fingerprint-chromium": "workspace:*",
    "@contextweave/kernel-standard-chromium": "workspace:*",
    "@contextweave/storage": "workspace:*",
    "@contextweave/worker-protocol": "workspace:*",
    "@fontsource-variable/public-sans": "5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "culori": "4.0.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.4",
    "embla-carousel-react": "^8.6.0",
    "execa": "^10.0.1",
    "https-proxy-agent": "^9.1.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "playwright-core": "^1.63.0",
    "proxy-chain": "^3.0.1",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.13.2",
    "recharts": "3.8.0",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yauzl": "^3.4.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "1.168.40",
    "@types/culori": "4.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "shadcn": "4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
