{
  "name": "contextweave",
  "version": "0.1.9",
  "private": true,
  "description": "An open-source multi-kernel browser workspace for personal and team operations.",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "pnpm --filter @contextweave/desktop dev",
    "build": "pnpm --filter @contextweave/desktop build",
    "build:dir": "pnpm --filter @contextweave/desktop build:dir",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:tooling",
    "format:check": "pnpm --filter @contextweave/desktop format:check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:fingerprint": "node scripts/smoke-fingerprint.mjs",
    "test:tooling": "node --test scripts/release-tools.test.mjs"
  }
}
